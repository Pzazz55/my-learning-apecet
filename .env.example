# Copy this file to .env for local development only.
# Never commit secrets or real credentials to Git.

# Required for the app's Turso database.
# Use the full credentialed URL from your Turso database.
# Example:
# STUDY_SPRINT_DATABASE_URL=libsql://your-auth-token@my-learning-apecet-pzazz55.aws-us-east-1.turso.io

# At least one provider key is required for question generation.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=

# Parent login required for results access.
PARENT_USERNAME=parent
PARENT_PASSWORD=change-this-password
