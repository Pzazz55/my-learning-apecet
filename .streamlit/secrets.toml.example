# Study Sprint — Streamlit Community Cloud secrets
#
# Paste the entries you need into the app's "Advanced settings -> Secrets" box
# (or into your workspace's app settings afterwards). Streamlit exposes every
# root-level key through `st.secrets` and as an environment variable.
#
# Locally you can either save this file as .streamlit/secrets.toml (it is
# excluded from Git) or keep using the .env file, which is also excluded.
#
# Values shown as "..." are placeholders — replace them with your real keys.

# --- Persistent results storage ---
# The app targets the Study Sprint Turso database. Include its auth token in the URL.

# Option 1: Turso (SQLite Flash) - Recommended for free tier
# Get your database URL from https://app.turso.tech/
# Format: libsql://auth-token@host
# STUDY_SPRINT_DATABASE_URL = "libsql://your-auth-token@my-learning-apecet-pzazz55.aws-us-east-1.turso.io"

# --- LLM provider keys: at least one is required ---
# Only the models whose key is present here are listed in the sidebar, so it is
# fine to keep an entry commented out until you have a key for it.
GROQ_API_KEY = "..."
OPENROUTER_API_KEY = "..."
GOOGLE_API_KEY = "..."
OPENAI_API_KEY = "..."
HF_TOKEN = "..."

# --- Parent Results login: required to open the Parent Results page ---
PARENT_USERNAME = "parent"
PARENT_PASSWORD = "change-this-password"
